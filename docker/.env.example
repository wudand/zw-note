# docker-compose.yml 用到的数据库连接参数模板。
# 复制一份改名为 .env（同目录下）并填入真实值：
#   cp docker/.env.example docker/.env
# .env 已加入 .gitignore，不会被提交；.env.example 仅作模板保留占位值。

# 账号 / 密码 / 库名需与实际 Postgres 实例（如 postgres-dev 容器）一致，
# 默认值对应 zw-note-backend/scripts/db.sh 里的默认值
DB_USER=hsop
DB_PASSWORD=change-me
DB_NAME=zw-note

# backend 容器连接数据库时用的地址：
# - 连宿主机上已有的 Postgres（如 postgres-dev）：host.docker.internal
# - 连本 compose 文件里 --profile local-db 起的 postgres 服务：postgres
DB_HOST=host.docker.internal
DB_PORT=5432
